---
interface Props {
  href: string;
  class?: string;
  variant?: 'primary' | 'secondary';
  target?: string;
  rel?: string;
}
const {href, class: className = '', variant = 'primary', target, rel} = Astro.props;
---
<a class:list={['btn', `btn-${variant}`, className]} href={href} target={target} rel={rel}>
  <span class="btn-label"><slot /></span>
</a>
