---
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';
---
<Base title={pagesMeta.notFound.title.en} titleZh={pagesMeta.notFound.title.zh} description={pagesMeta.notFound.description.en} descriptionZh={pagesMeta.notFound.description.zh}>
  <main id="main-content" class="not-found">
    <div class="section-inner">
      <p class="eyebrow">404 / PAGE NOT FOUND</p>
      <h1><T en="This page could not be found" zh="找不到这个页面" /></h1>
      <p><T en="The page is missing, or the documentation path has changed." zh="请求的页面不存在，或文档路径已经变更。" /></p>
      <BracketLink href={href()}><T en="Back to SiftQuery" zh="返回 SiftQuery" /></BracketLink>
    </div>
  </main>
</Base>
