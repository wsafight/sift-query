---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Box from '@lucide/astro/icons/box';
import Database from '@lucide/astro/icons/database';
import FileCode2 from '@lucide/astro/icons/file-code';
import Gauge from '@lucide/astro/icons/gauge';
import Layers3 from '@lucide/astro/icons/layers';
import LockKeyhole from '@lucide/astro/icons/lock-keyhole';
import Radio from '@lucide/astro/icons/radio';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import TerminalSquare from '@lucide/astro/icons/square-terminal';
import {Code} from 'astro:components';
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';

const startHref = href('start/quick-start');
const docsHref = href('docs');
const capabilities = [
  {en: 'Declared boundaries', zh: '声明查询边界', bodyEn: 'Entity metadata defines fields, allowed operators, projections and stable ordering. Invalid parameters fail before database execution.', bodyZh: '实体元数据声明字段、可用运算符、投影和稳定排序。非法参数在执行数据库操作前被拒绝。'},
  {en: 'Typed query intent', zh: '类型化查询意图', bodyEn: 'URL parameters, the Rust QueryBuilder and RPC share a typed query model, with explicit WHERE and HAVING semantics.', bodyZh: 'URL 参数、Rust QueryBuilder 和 RPC 共用类型化查询模型，明确区分 WHERE 与 HAVING。'},
  {en: 'Server-owned scope', zh: '服务端权限范围', bodyEn: 'Your application supplies ServerScope from trusted identity and authorization. User filters stay within that scope.', bodyZh: '应用根据可信身份和授权生成 ServerScope。用户筛选始终受服务端范围约束。'},
  {en: 'Bounded execution', zh: '有预算的执行', bodyEn: 'Values use bind parameters. Query budgets, timeouts and bounded scan/export keep request work explicit.', bodyZh: '运行时值通过参数绑定进入 SQL。查询预算、超时和有界扫描、导出让请求工作量可控。'},
];
const features = [
  {en: 'Three database backends', zh: '三个独立数据库后端', bodyEn: 'PostgreSQL, MySQL/MariaDB and SQLite use separate crates and drivers. Select the backend your application needs.', bodyZh: 'PostgreSQL、MySQL/MariaDB 与 SQLite 分别使用独立 crate 和驱动，按应用需求选择。'},
  {en: 'The result shape you need', zh: '按需选择结果形态', bodyEn: 'Return typed rows or dynamic maps, request summaries, or use signed keyset cursors for sequential paging.', bodyZh: '返回类型化行或动态 Map，按需请求聚合，或使用签名 keyset cursor 连续翻页。'},
  {en: 'An explicit production contract', zh: '显式的生产合同', bodyEn: 'Codecs, labels, web adapters and observers extend the query pipeline. PostgreSQL adds schema validation, facets and optional native capabilities.', bodyZh: 'Codec、Label、Web adapter 和观测扩展查询管线。PostgreSQL 另提供 Schema 校验、Facet 和可选原生能力。'},
];
const modules = [
  {icon: ShieldCheck, en: 'Scope + field access', zh: 'Scope + 字段访问', bodyEn: 'Trusted authorization boundaries', bodyZh: '可信授权与字段访问边界'},
  {icon: Layers3, en: 'Projection + summaries', zh: '投影 + 聚合', bodyEn: 'Typed rows, maps, SUM / AVG / MIN / MAX', bodyZh: '类型化行、Map 与汇总结果'},
  {icon: RefreshCw, en: 'Signed cursors', zh: '签名游标', bodyEn: 'Stable keyset pagination', bodyZh: '稳定排序的 keyset 分页'},
  {icon: Box, en: 'Scan + CSV', zh: '扫描 + CSV', bodyEn: 'Bounded streams and export budgets', bodyZh: '有界流与导出预算'},
  {icon: Radio, en: 'Web + TypeScript', zh: 'Web + TypeScript', bodyEn: 'Adapters, query builder and RPC', bodyZh: '框架适配、查询构建器与 RPC'},
  {icon: FileCode2, en: 'Codec + labels', zh: 'Codec + Label', bodyEn: 'Typed conversion and result enrichment', bodyZh: '类型化转换与结果增强'},
  {icon: Gauge, en: 'Template cache', zh: 'SQL 模板缓存', bodyEn: 'Reuse SQL shapes, bind current values', bodyZh: '复用 SQL 形态，重新绑定当前值'},
  {icon: LockKeyhole, en: 'PostgreSQL extensions', zh: 'PostgreSQL 扩展', bodyEn: 'Opt-in full text, native types and RLS', bodyZh: '按需启用全文、原生类型与 RLS'},
];
const steps = [
  {en: 'Select your backend', zh: '选择数据库后端', bodyEn: 'Install sift-query 0.1.0 from crates.io. Disable default features to choose MySQL or SQLite without the PostgreSQL driver.', bodyZh: '从 crates.io 安装 sift-query 0.1.0。关闭默认 feature，即可单独选择 MySQL 或 SQLite 驱动。'},
  {en: 'Declare an entity', zh: '声明查询实体', bodyEn: 'Derive SearchEntity and declare fields, operators and stable ordering. Keep database schema and migrations in your application.', bodyZh: '派生 SearchEntity，声明字段、运算符和稳定排序。数据库 Schema 和迁移由应用维护。'},
  {en: 'Parse, authorize, execute', zh: '解析、授权、执行', bodyEn: 'Parse raw parameters, build a trusted ServerScope, and run the query. Choose query budgets and test against your deployment database.', bodyZh: '解析原始参数，构造可信 ServerScope，再执行查询。配置预算，并在目标数据库上验证。'},
];
const entityCode = `#[derive(Debug, sqlx::FromRow, SearchEntity)]
#[search_entity(
    from = "users",
    default_order = "id:asc",
    stable_order = "id:asc"
)]
struct User {
    #[search_field(sortable, cursor_non_null,
        operators = [Eq, InList])]
    id: i64,
    #[search_field(operators = [Eq, StartWith])]
    name: String,
}

// name=A&name-op=sw&size=10`;
---
<Base title={pagesMeta.home.title.en} titleZh={pagesMeta.home.title.zh} description={pagesMeta.home.description.en} descriptionZh={pagesMeta.home.description.zh} home>
  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-graph" aria-hidden="true">
        <div class="graph-axis graph-axis-x"></div><div class="graph-axis graph-axis-y"></div>
        <div class="graph-node graph-spec"><FileCode2 size={16} /><span>QUERY PARAMS</span></div>
        <div class="graph-node graph-core"><span>SQL</span><i></i></div>
        <div class="graph-node graph-db"><Database size={16} /><span>POSTGRES</span></div>
        <div class="graph-node graph-api"><TerminalSquare size={16} /><span>MYSQL / MARIADB</span></div>
        <div class="graph-node graph-web"><Layers3 size={16} /><span>SQLITE</span></div>
        <div class="graph-line line-spec"></div><div class="graph-line line-db"></div><div class="graph-line line-api"></div><div class="graph-line line-web"></div>
        <span class="graph-status">TYPED / PARAMETERIZED / BOUNDED</span>
      </div>
      <div class="hero-inner section-inner">
        <div class="hero-copy-block">
          <p class="eyebrow"><T en="Query intent in. Typed results out." zh="输入查询意图，返回类型化结果。" /></p>
          <h1>SiftQuery</h1>
          <p class="hero-statement"><T en="Declare your query model.<br>Let Rust handle the SQL." zh="声明查询模型。<br>让 Rust 处理查询 SQL。" /></p>
        </div>
        <div class="hero-bottom">
          <div class="hero-cta"><BracketLink href={startHref}><T en="Run your first query" zh="运行第一个查询" /></BracketLink><a class="text-link" href={docsHref}><T en="Explore the documentation" zh="阅读完整文档" /></a></div>
          <p><T en="A typed, read-only query library for Rust and SQLx. Validate fields, operators and budgets, apply server-owned scopes, and execute parameterized queries across three database backends." zh="Rust 与 SQLx 的类型化只读查询库。校验字段、运算符和预算，应用服务端权限范围，在三个数据库后端上执行参数化查询。" /></p>
        </div>
      </div>
    </section>
    <section class="compiler-section light-section" id="compiler">
      <div class="section-inner">
        <div class="section-heading split-heading"><div><p class="eyebrow"><T en="01 / The query model" zh="01 / 查询模型" /></p><h2><T en="Describe the boundary.<br>Accept query intent." zh="声明查询边界。<br>接收查询意图。" /></h2></div><p class="section-lede"><T en="One entity contract connects parameter parsing, query planning and SQL rendering. Fields and operators come from your application; values come from the request." zh="一份实体合同连接参数解析、查询计划和 SQL 渲染。字段与运算符由应用声明，查询值来自请求。" /></p></div>
        <div class="capability-panels">{capabilities.map((item, i) => <article class:list={['capability-panel', {'is-active': i === 0}]}><button class="capability-trigger" type="button"><span>0{i + 1}</span><strong><T en={item.en} zh={item.zh} /></strong></button><p><T en={item.bodyEn} zh={item.bodyZh} /></p></article>)}</div>
      </div>
    </section>
    <section class="spec-section dark-section">
      <div class="section-inner spec-layout">
        <div class="section-heading"><p class="eyebrow"><T en="02 / Entity to query contract" zh="02 / 从实体到查询合同" /></p><h2><T en="A small declaration.<br>An explicit contract." zh="简洁的声明。<br>明确的查询合同。" /></h2><p class="section-lede"><T en="Declare searchable fields and allowed operators with derive macros. Parse URL parameters or build typed queries in Rust. The same metadata controls both paths." zh="用 derive 声明可查询字段与允许的运算符，再解析 URL 参数或在 Rust 中构造类型化查询。两条路径由同一份元数据约束。" /></p></div>
        <div class="code-workbench"><div class="workbench-tabs"><span class="is-current">src/entity.rs</span><span>GET /users</span></div><Code code={entityCode} lang="rust" theme="github-dark-default" /><div class="build-log"><span><i class="status-ok"></i>SearchEntity</span><span><i class="status-ok"></i>field whitelist</span><span><i class="status-ok"></i>bound values</span><strong>READ ONLY</strong></div></div>
      </div>
    </section>
    <section class="runtime-section light-section" id="runtime">
      <div class="section-inner runtime-layout">
        <div class="runtime-copy"><p class="eyebrow"><T en="03 / Query execution" zh="03 / 查询执行" /></p><h2><T en="Useful for the first list.<br>Ready for richer queries." zh="从第一个列表开始。<br>支持更丰富的查询。" /></h2><ul class="feature-list">{features.map(item => <li><strong><T en={item.en} zh={item.zh} /></strong><span><T en={item.bodyEn} zh={item.bodyZh} /></span></li>)}</ul></div>
        <div class="app-preview" aria-label="Illustrative query result, not a generated application">
          <div class="preview-topbar"><span class="preview-mark"><span class="preview-brand-dot"></span>SQ</span><span><T en="Example query result" zh="查询结果示意" /></span><div><i></i><i></i><i></i></div></div>
          <div class="preview-body"><aside><strong>QUERY</strong><span class="active">Parameters</span><span>ServerScope</span><span>Rows</span><span>Summary</span><span>Cursor</span></aside><div class="preview-main">
            <div class="preview-title"><div><small>Read-only / example</small><strong>Users</strong></div></div>
            <div class="preview-metrics"><span><small>ROWS</small><strong>4</strong></span><span><small>SIZE</small><strong>10</strong></span><span><small>BACKENDS</small><strong>3</strong></span></div>
            <div class="preview-toolbar"><span>name=A&amp;name-op=sw&amp;size=10</span><b>id:asc</b></div>
            <div class="preview-table"><div class="preview-row table-head"><span>NAME</span><span>ID</span><span>OPERATOR</span><span>SCOPE</span></div>{['Alice', 'Ari', 'Alex', 'Ada'].map((name, i) => <div class="preview-row"><span><i class="row-dot green"></i>{name}</span><span>{i + 1}</span><span><em class="active-status">StartWith</em></span><span>Public demo</span></div>)}</div>
          </div></div>
        </div>
      </div>
    </section>
    <section class="modules-section dark-section" id="modules"><div class="section-inner">
      <div class="section-heading split-heading"><div><p class="eyebrow"><T en="04 / Query capabilities" zh="04 / 查询能力" /></p><h2><T en="Build on a shared<br>query contract." zh="在同一份查询合同上<br>扩展业务能力。" /></h2></div><p class="section-lede"><T en="Core query semantics stay portable. Choose optional features explicitly, and use the backend guide to check which capabilities your database supports." zh="核心查询语义保持可移植。显式选择可选 feature，并通过后端指南确认目标数据库支持的能力。" /></p></div>
      <div class="module-grid">{modules.map(({icon: Icon, ...item}) => <article><Icon size={21} /><strong><T en={item.en} zh={item.zh} /></strong><span><T en={item.bodyEn} zh={item.bodyZh} /></span></article>)}</div>
    </div></section>
    <section class="delivery-section light-section" id="delivery"><div class="section-inner delivery-layout"><div><p class="eyebrow"><T en="05 / Add it to your application" zh="05 / 接入现有应用" /></p><h2><T en="Three steps.<br>Your Rust application." zh="三个步骤。<br>接入你的 Rust 应用。" /></h2></div><ol class="delivery-steps">{steps.map((item, i) => <li><span>0{i + 1}</span><div><strong><T en={item.en} zh={item.zh} /></strong><p><T en={item.bodyEn} zh={item.bodyZh} /></p></div></li>)}</ol></div></section>
    <section class="final-cta dark-section"><div class="section-inner final-layout"><div><p class="eyebrow">SIFTQUERY / CRATES.IO / 0.1.0</p><h2><T en="Declare once.<br>Query with confidence." zh="一次声明。<br>按合同执行查询。" /></h2></div><div class="final-action"><p><T en="Start with the runnable SQLite example, then select your production backend. Version 0.1.0 is published; the API is pre-1.0." zh="先运行 SQLite 示例，再选择生产后端。0.1.0 已发布，当前 API 为 pre-1.0。" /></p><BracketLink href={startHref}><T en="Open the quick start" zh="打开快速开始" /> <ArrowRight size={15} /></BracketLink><span>Rust 1.99 · SQLx 0.9 · Apache-2.0</span></div></div></section>
  </main>
</Base>
