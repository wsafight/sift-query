---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import {getCollection} from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocSidebar from '../../components/DocSidebar.astro';
import T from '../../components/T.astro';
import {groupedPages, href, pages} from '../../catalog';
import {pagesMeta} from '../../i18n';
import '../../styles/docs.css';
const docsEn = await getCollection('docsEn');
const docsZh = await getCollection('docsZh');
for (const page of pages) {
  if (!docsEn.some(entry => entry.id === page.slug) || !docsZh.some(entry => entry.id === page.slug)) throw new Error(`Missing documentation entry for ${page.source}`);
}
---
<Base title={pagesMeta.docs.title.en} titleZh={pagesMeta.docs.title.zh} description={pagesMeta.docs.description.en} descriptionZh={pagesMeta.docs.description.zh}>
  <main id="main-content" class="docs-shell docs-index-shell" data-pagefind-ignore>
    <div class="docs-chrome">
      <DocSidebar />
    </div>
    <article class="docs-main">
      <div class="docs-hero">
        <p class="docs-kicker">SiftQuery / <T en="Documentation" zh="文档" /></p>
        <h1><T en="From your first query to production" zh="从第一个查询，到生产接入" /></h1>
        <p class="docs-lead"><T en="Start with a runnable example, then explore query semantics, backend capabilities and production contracts. English reference pages are concise guides; Chinese pages include the full specifications." zh="先运行一个查询，再按主题阅读查询语义、数据库能力和生产合同。中文收录完整规范，英文提供对应的精简指南。" /></p>
      </div>
      <div class="docs-index">
        {groupedPages.map(group => (
          <section class="docs-index-section">
            <div class="docs-index-head">
              <span class="docs-index-num">{group.number}</span>
              <h2><T en={group.label.en} zh={group.label.zh} /></h2>
            </div>
            <div class="docs-index-cards">
              {group.pages.map(page => (
                <a class="docs-index-card" href={href(page.slug)}>
                  <div class="docs-index-card-top">
                    <strong><T en={page.title.en} zh={page.title.zh} /></strong>
                    <ArrowRight size={14} class="docs-index-arrow" aria-hidden="true" />
                  </div>
                  <p><T en={page.description.en} zh={page.description.zh} /></p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </article>
  </main>
</Base>
