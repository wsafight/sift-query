---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Box from '@lucide/astro/icons/box';
import CheckCircle2 from '@lucide/astro/icons/circle-check';
import Copy from '@lucide/astro/icons/copy';
import Database from '@lucide/astro/icons/database';
import FileCode2 from '@lucide/astro/icons/file-code';
import Gauge from '@lucide/astro/icons/gauge';
import Layers3 from '@lucide/astro/icons/layers';
import LockKeyhole from '@lucide/astro/icons/lock-keyhole';
import Radio from '@lucide/astro/icons/radio';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Sparkles from '@lucide/astro/icons/sparkles';
import TerminalSquare from '@lucide/astro/icons/square-terminal';
import {Code} from 'astro:components';
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href, siteVersion} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';

const startHref = href('start/quick-start');
const docsHref = href('docs');
const installCmd = 'cargo add sift-query --no-default-features -F sqlite,serde';

const capabilities = [
  {
    icon: ShieldCheck,
    tag: 'SearchEntity',
    en: 'Declared boundaries',
    zh: '声明查询边界',
    bodyEn: 'Entity metadata defines fields, allowed operators, projections and stable ordering. Invalid parameters fail before database execution.',
    bodyZh: '实体元数据声明字段、可用运算符、投影和稳定排序。非法参数在执行数据库操作前被拒绝。',
    snippet: '#[search_field(operators = [Eq, StartWith])]',
  },
  {
    icon: FileCode2,
    tag: 'QueryPlan',
    en: 'Typed query intent',
    zh: '类型化查询意图',
    bodyEn: 'URL parameters, the Rust QueryBuilder and RPC share a typed query model, with explicit WHERE and HAVING semantics.',
    bodyZh: 'URL 参数、Rust QueryBuilder 和 RPC 共用类型化查询模型，明确区分 WHERE 与 HAVING。',
    snippet: 'name=A&name-op=sw&sort=id:asc&size=10',
  },
  {
    icon: LockKeyhole,
    tag: 'ServerScope',
    en: 'Server-owned scope',
    zh: '服务端权限范围',
    bodyEn: 'Your application supplies ServerScope from trusted identity and authorization. User filters stay within that scope.',
    bodyZh: '应用根据可信身份和授权生成 ServerScope。用户筛选始终受服务端范围约束。',
    snippet: 'ServerScope::for_entity::<User>().eq(TENANT_ID, 42)',
  },
  {
    icon: Gauge,
    tag: 'QueryBudget',
    en: 'Bounded execution',
    zh: '有预算的执行',
    bodyEn: 'Values use bind parameters. Query budgets, timeouts and bounded scan/export keep request work explicit.',
    bodyZh: '运行时值通过参数绑定进入 SQL。查询预算、超时和有界扫描、导出让请求工作量可控。',
    snippet: 'LIMIT $3 OFFSET $4 -- max_size: 100',
  },
];

const features = [
  {
    en: 'Three database backends',
    zh: '三个独立数据库后端',
    bodyEn: 'PostgreSQL, MySQL/MariaDB and SQLite use separate crates and drivers. Select the backend your application needs.',
    bodyZh: 'PostgreSQL、MySQL/MariaDB 与 SQLite 分别使用独立 crate 和驱动，按应用需求选择。',
  },
  {
    en: 'The result shape you need',
    zh: '按需选择结果形态',
    bodyEn: 'Return typed rows or dynamic maps, request summaries, or use signed keyset cursors for sequential paging.',
    bodyZh: '返回类型化行或动态 Map，按需请求聚合，或使用签名 keyset cursor 连续翻页。',
  },
  {
    en: 'An explicit production contract',
    zh: '显式的生产合同',
    bodyEn: 'Codecs, labels, web adapters and observers extend the query pipeline. PostgreSQL adds schema validation, facets and optional native capabilities.',
    bodyZh: 'Codec、Label、Web adapter 和观测扩展查询管线。PostgreSQL 另提供 Schema 校验、Facet 和可选原生能力。',
  },
];

const modules = [
  {icon: ShieldCheck, en: 'Scope + field access', zh: 'Scope + 字段访问', bodyEn: 'Trusted authorization boundaries', bodyZh: '可信授权与字段访问边界'},
  {icon: Layers3, en: 'Projection + summaries', zh: '投影 + 聚合', bodyEn: 'Typed rows, maps, SUM / AVG / MIN / MAX', bodyZh: '类型化行、Map 与汇总结果'},
  {icon: RefreshCw, en: 'Signed cursors', zh: '签名游标', bodyEn: 'Stable keyset pagination', bodyZh: '稳定排序的 keyset 分页'},
  {icon: Box, en: 'Scan + CSV', zh: '扫描 + CSV', bodyEn: 'Bounded streams and export budgets', bodyZh: '有界流与导出预算'},
  {icon: Radio, en: 'Web + TypeScript', zh: 'Web + TypeScript', bodyEn: 'Adapters, query builder and RPC', bodyZh: '框架适配、查询构建器与 RPC'},
  {icon: FileCode2, en: 'Codec + labels', zh: 'Codec + Label', bodyEn: 'Typed conversion and result enrichment', bodyZh: '类型化转换与结果增强'},
  {icon: Gauge, en: 'Template cache', zh: 'SQL 模板缓存', bodyEn: 'Reuse SQL shapes, bind current values', bodyZh: '复用 SQL 形态，重新绑定当前值'},
  {icon: LockKeyhole, en: 'PostgreSQL extensions', zh: 'PostgreSQL 扩展', bodyEn: 'Opt-in full text, native types and RLS', bodyZh: '按需启用全文、原生类型与 RLS'},
];

const steps = [
  {
    en: 'Select your backend',
    zh: '选择数据库后端',
    cmd: 'cargo add sift-query --no-default-features -F sqlite,serde',
    bodyEn: `Install sift-query ${siteVersion} from crates.io. Disable default features to choose MySQL or SQLite without the PostgreSQL driver.`,
    bodyZh: `从 crates.io 安装 sift-query ${siteVersion}。关闭默认 feature，即可单独选择 MySQL 或 SQLite 驱动。`,
  },
  {
    en: 'Declare an entity',
    zh: '声明查询实体',
    cmd: '#[derive(sqlx::FromRow, SearchEntity)]',
    bodyEn: 'Derive SearchEntity and declare fields, operators and stable ordering. Keep database schema and migrations in your application.',
    bodyZh: '派生 SearchEntity，声明字段、运算符和稳定排序。数据库 Schema 和迁移由应用维护。',
  },
  {
    en: 'Parse, authorize, execute',
    zh: '解析、授权、执行',
    cmd: 'search.search(&query, &scope).await?',
    bodyEn: 'Parse raw parameters, build a trusted ServerScope, and run the query. Choose query budgets and test against your deployment database.',
    bodyZh: '解析原始参数，构造可信 ServerScope，再执行查询。配置预算，并在目标数据库上验证。',
  },
];

const entityCode = `#[derive(Debug, sqlx::FromRow, SearchEntity)]
#[search_entity(
    from = "users",
    default_order = "id:asc",
    stable_order = "id:asc"
)]
struct User {
    #[search_field(sortable, cursor_non_null,
        operators = [Eq, InList])]
    id: i64,
    #[search_field(operators = [Eq, StartWith])]
    name: String,
}`;

const requestCode = `// Incoming HTTP query string:
// GET /users?name=A&name-op=sw&size=10

let raw = RawParams::parse("name=A&name-op=sw&size=10")?;
let query = search.parse::<User>(&raw)?;

// Trusted scope from authenticated session:
let scope = ServerScope::for_entity::<User>()
    .eq(User::TENANT_ID, auth.tenant_id)?;

let page = search.search(&query, &scope).await?;`;

const sqlCode = `-- Parameterized SQL rendered from validated plan:
SELECT "id", "name"
FROM "users"
WHERE ("tenant_id" = $1)
  AND ("name" LIKE $2 ESCAPE '\\')
ORDER BY "id" ASC
LIMIT $3 OFFSET $4

-- Binds:
-- $1 = 42          (ServerScope)
-- $2 = "A%"        (escaped StartWith)
-- $3 = 10          (page size budget)
-- $4 = 0           (offset)`;
---
<Base title={pagesMeta.home.title.en} titleZh={pagesMeta.home.title.zh} description={pagesMeta.home.description.en} descriptionZh={pagesMeta.home.description.zh} home>
  <main id="main-content" class="home-main">
    <section class="hero" id="top">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <div class="section-inner hero-grid">
        <div class="hero-copy">
          <a class="release-badge" href={href('project/changelog')}>
            <Sparkles size={13} />
            <span>v{siteVersion}</span>
            <span class="release-sep" aria-hidden="true">·</span>
            <T en="Published on crates.io · Rust 1.95+ · SQLx 0.9" zh="已发布至 crates.io · Rust 1.95+ · SQLx 0.9" />
          </a>
          <h1 class="hero-title">SiftQuery</h1>
          <p class="hero-statement">
            <T en="Declare your query model.<br>Let Rust handle the SQL." zh="声明查询模型。<br>让 Rust 处理查询 SQL。" />
          </p>
          <p class="hero-desc">
            <T
              en="A typed, read-only query library for Rust and SQLx. Validate fields, operators and budgets, enforce server-owned scopes, and execute parameterized SQL across three database backends."
              zh="Rust 与 SQLx 的类型化只读查询库。校验字段、运算符和预算，强制应用服务端权限范围，在三个数据库后端上执行参数化 SQL。"
            />
          </p>
          <div class="hero-actions">
            <BracketLink href={startHref}>
              <T en="Run your first query" zh="运行第一个查询" />
              <ArrowRight size={15} />
            </BracketLink>
            <BracketLink href={docsHref} variant="secondary">
              <T en="Explore the documentation" zh="阅读完整文档" />
            </BracketLink>
          </div>
          <div class="hero-install">
            <span class="install-prompt" aria-hidden="true">$</span>
            <code>{installCmd}</code>
            <button type="button" class="copy-inline" data-copy-text={installCmd}>
              <Copy size={13} aria-hidden="true" />
              <span><T en="Copy" zh="复制" /></span>
            </button>
          </div>
          <div class="backend-pills" aria-label="Supported database backends">
            <span><Database size={13} /> PostgreSQL</span>
            <span><TerminalSquare size={13} /> MySQL / MariaDB</span>
            <span><Layers3 size={13} /> SQLite</span>
          </div>
        </div>

        <div class="hero-demo" data-hero-demo>
          <div class="demo-header">
            <div class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="demo-tabs" role="tablist" aria-label="Query pipeline examples">
              <button type="button" role="tab" aria-selected="true" class="demo-tab is-active" data-demo-tab="filter">
                <T en="Filter & Page" zh="筛选与分页" />
              </button>
              <button type="button" role="tab" aria-selected="false" class="demo-tab" data-demo-tab="scope">
                <T en="Tenant Scope" zh="租户隔离" />
              </button>
              <button type="button" role="tab" aria-selected="false" class="demo-tab" data-demo-tab="cursor">
                <T en="Keyset Cursor" zh="签名游标" />
              </button>
            </div>
          </div>

          <div class="demo-panel" data-demo-panel="filter">
            <div class="pipe-step">
              <div class="pipe-label"><span class="pipe-badge">01 HTTP INTENT</span><code>GET /users</code></div>
              <div class="pipe-code">?name=A&amp;name-op=sw&amp;sort=id:asc&amp;size=10</div>
            </div>
            <div class="pipe-step">
              <div class="pipe-label"><span class="pipe-badge ok">02 CONTRACT CHECK</span><code>SearchEntity::User</code></div>
              <div class="pipe-checks">
                <span><CheckCircle2 size={13} /> field: name</span>
                <span><CheckCircle2 size={13} /> op: StartWith</span>
                <span><CheckCircle2 size={13} /> size ≤ 100</span>
              </div>
            </div>
            <div class="pipe-step pipe-sql">
              <div class="pipe-label"><span class="pipe-badge info">03 BOUND SQL</span><code>PostgreSQL / MySQL / SQLite</code></div>
              <pre><code>SELECT "id", "name" FROM "users"
WHERE ("name" LIKE $1 ESCAPE '\')
ORDER BY "id" ASC LIMIT $2 OFFSET $3
-- $1 = "A%", $2 = 10, $3 = 0</code></pre>
            </div>
          </div>

          <div class="demo-panel" data-demo-panel="scope" hidden>
            <div class="pipe-step">
              <div class="pipe-label"><span class="pipe-badge">01 UNTRUSTED INPUT</span><code>GET /orders</code></div>
              <div class="pipe-code">?status=paid&amp;tenant_id=999 <em class="rejected-tag">ignored</em></div>
            </div>
            <div class="pipe-step">
              <div class="pipe-label"><span class="pipe-badge ok">02 SERVER SCOPE</span><code>auth.tenant_id = 42</code></div>
              <div class="pipe-checks">
                <span><CheckCircle2 size={13} /> tenant_id pinned</span>
                <span><CheckCircle2 size={13} /> field access policy</span>
              </div>
            </div>
            <div class="pipe-step pipe-sql">
              <div class="pipe-label"><span class="pipe-badge info">03 ENFORCED SQL</span><code>Parameterized</code></div>
              <pre><code>SELECT "id", "status", "total_cents"
FROM "orders"
WHERE ("tenant_id" = $1) AND ("status" = $2)
-- $1 = 42 (trusted), $2 = "paid"</code></pre>
            </div>
          </div>

          <div class="demo-panel" data-demo-panel="cursor" hidden>
            <div class="pipe-step">
              <div class="pipe-label"><span class="pipe-badge">01 CURSOR REQUEST</span><code>GET /users</code></div>
              <div class="pipe-code">?cursor=eyJvcmRlciI6ImlkOmFzYyIsInYiOlsxMl19&amp;size=20</div>
            </div>
            <div class="pipe-step">
              <div class="pipe-label"><span class="pipe-badge ok">02 HMAC-SHA256</span><code>Verified &amp; Shape-Matched</code></div>
              <div class="pipe-checks">
                <span><CheckCircle2 size={13} /> signature ok</span>
                <span><CheckCircle2 size={13} /> stable_order: id:asc</span>
              </div>
            </div>
            <div class="pipe-step pipe-sql">
              <div class="pipe-label"><span class="pipe-badge info">03 KEYSET SEEK</span><code>O(log N) Index Scan</code></div>
              <pre><code>SELECT "id", "name" FROM "users"
WHERE ("id" &gt; $1)
ORDER BY "id" ASC LIMIT $2
-- $1 = 12, $2 = 21 (has_more probe)</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section" id="compiler">
      <div class="section-inner">
        <div class="section-header split">
          <div>
            <p class="eyebrow"><T en="01 / The query model" zh="01 / 查询模型" /></p>
            <h2><T en="Describe the boundary.<br>Accept query intent." zh="声明查询边界。<br>接收查询意图。" /></h2>
          </div>
          <p class="section-lede">
            <T
              en="One entity contract connects parameter parsing, query planning and SQL rendering. Fields and operators come from your application; values come from the request."
              zh="一份实体合同连接参数解析、查询计划和 SQL 渲染。字段与运算符由应用声明，查询值来自请求。"
            />
          </p>
        </div>
        <div class="bento-grid">
          {capabilities.map(({icon: Icon, ...item}, i) => (
            <article class="bento-card">
              <div class="bento-top">
                <span class="bento-icon"><Icon size={18} /></span>
                <span class="bento-tag">0{i + 1} · {item.tag}</span>
              </div>
              <h3><T en={item.en} zh={item.zh} /></h3>
              <p><T en={item.bodyEn} zh={item.bodyZh} /></p>
              <code class="bento-snippet">{item.snippet}</code>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section section-tinted">
      <div class="section-inner spec-grid">
        <div class="section-header">
          <p class="eyebrow"><T en="02 / Entity to query contract" zh="02 / 从实体到查询合同" /></p>
          <h2><T en="A small declaration.<br>An explicit contract." zh="简洁的声明。<br>明确的查询合同。" /></h2>
          <p class="section-lede">
            <T
              en="Declare searchable fields and allowed operators with derive macros. Parse URL parameters or build typed queries in Rust. The same metadata controls both paths."
              zh="用 derive 声明可查询字段与允许的运算符，再解析 URL 参数或在 Rust 中构造类型化查询。两条路径由同一份元数据约束。"
            />
          </p>
          <ul class="spec-highlights">
            <li><CheckCircle2 size={16} /> <T en="Compile-time field constants and typed operator whitelists" zh="编译期字段常量与类型化运算符白名单" /></li>
            <li><CheckCircle2 size={16} /> <T en="Zero dynamic SQL concatenation for user input values" zh="用户输入值绝不拼接进 SQL 文本" /></li>
            <li><CheckCircle2 size={16} /> <T en="Shared contract across Axum, Actix, Poem and TypeScript" zh="在 Axum、Actix、Poem 与 TypeScript 客户端间共享合同" /></li>
          </ul>
        </div>
        <div class="code-workbench" data-workbench>
          <div class="workbench-bar">
            <div class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="workbench-tabs" role="tablist" aria-label="Query pipeline code">
              <button type="button" role="tab" aria-selected="true" class="workbench-tab is-current" data-tab="entity">src/entity.rs</button>
              <button type="button" role="tab" aria-selected="false" class="workbench-tab" data-tab="request">GET /users</button>
              <button type="button" role="tab" aria-selected="false" class="workbench-tab" data-tab="sql">Rendered SQL</button>
            </div>
          </div>
          <div class="workbench-panel" data-panel="entity"><Code code={entityCode} lang="rust" theme="github-dark-default" /></div>
          <div class="workbench-panel" data-panel="request" hidden><Code code={requestCode} lang="rust" theme="github-dark-default" /></div>
          <div class="workbench-panel" data-panel="sql" hidden><Code code={sqlCode} lang="sql" theme="github-dark-default" /></div>
          <div class="build-log">
            <span><i class="status-ok"></i>SearchEntity</span>
            <span><i class="status-ok"></i>field whitelist</span>
            <span><i class="status-ok"></i>bound values</span>
            <strong>READ ONLY</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section" id="runtime">
      <div class="section-inner runtime-grid">
        <div class="runtime-copy">
          <p class="eyebrow"><T en="03 / Execution & three backends" zh="03 / 执行与三套后端" /></p>
          <h2><T en="Useful for the first list.<br>Ready for production." zh="快速跑通列表查询。<br>从容应对生产约束。" /></h2>
          <div class="feature-list">
            {features.map((item, i) => (
              <article class="feature-item">
                <span class="feature-num">0{i + 1}</span>
                <div>
                  <h3><T en={item.en} zh={item.zh} /></h3>
                  <p><T en={item.bodyEn} zh={item.bodyZh} /></p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="app-preview" data-preview>
          <div class="preview-chrome">
            <div class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <span>sift-query · runtime inspector</span>
            <span class="preview-badge">SQLx 0.9</span>
          </div>
          <div class="preview-body">
            <aside role="tablist" aria-label="Query output previews">
              <strong>RESULT MODES</strong>
              <button type="button" role="tab" aria-selected="true" class="preview-tab active" data-preview-tab="rows">Rows</button>
              <button type="button" role="tab" aria-selected="false" class="preview-tab" data-preview-tab="scope">ServerScope</button>
              <button type="button" role="tab" aria-selected="false" class="preview-tab" data-preview-tab="summary">Summary</button>
              <button type="button" role="tab" aria-selected="false" class="preview-tab" data-preview-tab="cursor">Cursor</button>
            </aside>
            <div class="preview-main">
              <div class="preview-view" data-preview-view="rows">
                <div class="preview-header">
                  <span>GET /users?name=A&amp;name-op=sw&amp;size=10</span>
                  <b>10 / 24 rows</b>
                </div>
                <div class="preview-table">
                  <div class="preview-row table-head"><span>ENTITY</span><span>OPERATOR</span><span>STATUS</span><span>BIND</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>Users</span><span>StartWith</span><span><em class="status-pill ok">Bound</em></span><span>$1 = "A%"</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>Orders</span><span>Between</span><span><em class="status-pill ok">Scoped</em></span><span>tenant = 42</span></div>
                  <div class="preview-row"><span><i class="row-dot info"></i>Invoices</span><span>Summary</span><span><em class="status-pill info">Aggregated</em></span><span>SUM(total)</span></div>
                </div>
              </div>
              <div class="preview-view" data-preview-view="scope" hidden>
                <div class="preview-header">
                  <span>ServerScope::for_entity::&lt;Order&gt;()</span>
                  <b>tenant_id = 42</b>
                </div>
                <div class="preview-table">
                  <div class="preview-row table-head"><span>BOUNDARY</span><span>SOURCE</span><span>MODE</span><span>EFFECT</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>tenant_id</span><span>JWT claims</span><span><em class="status-pill ok">Pinned</em></span><span>AND $1</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>deleted_at</span><span>Policy</span><span><em class="status-pill ok">IsNull</em></span><span>Soft delete</span></div>
                  <div class="preview-row"><span><i class="row-dot warn"></i>cost_cents</span><span>Field ACL</span><span><em class="status-pill warn">Denied</em></span><span>Hidden</span></div>
                </div>
              </div>
              <div class="preview-view" data-preview-view="summary" hidden>
                <div class="preview-header">
                  <span>GET /orders?status=paid&amp;summary=amount:sum</span>
                  <b>1 query</b>
                </div>
                <div class="preview-table">
                  <div class="preview-row table-head"><span>METRIC</span><span>FIELD</span><span>MODE</span><span>VALUE</span></div>
                  <div class="preview-row"><span><i class="row-dot info"></i>COUNT(*)</span><span>total</span><span><em class="status-pill info">Exact</em></span><span>1,248</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>SUM</span><span>amount</span><span><em class="status-pill ok">Decimal</em></span><span>84,920.50</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>AVG</span><span>amount</span><span><em class="status-pill ok">Decimal</em></span><span>68.04</span></div>
                </div>
              </div>
              <div class="preview-view" data-preview-view="cursor" hidden>
                <div class="preview-header">
                  <span>?cursor=eyJvcmRlciI6...&amp;size=10</span>
                  <b>id:asc</b>
                </div>
                <div class="preview-table">
                  <div class="preview-row table-head"><span>PROPERTY</span><span>CONTRACT</span><span>CHECK</span><span>RESULT</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>Keyset seek</span><span>id &gt; $last</span><span><em class="status-pill ok">Index</em></span><span>O(log N)</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>Tamper check</span><span>HMAC-SHA256</span><span><em class="status-pill ok">Verified</em></span><span>Valid</span></div>
                  <div class="preview-row"><span><i class="row-dot ok"></i>Entity binding</span><span>Shape hash</span><span><em class="status-pill ok">Matched</em></span><span>Users</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section section-tinted" id="modules">
      <div class="section-inner">
        <div class="section-header split">
          <div>
            <p class="eyebrow"><T en="04 / Query capabilities" zh="04 / 查询能力" /></p>
            <h2><T en="Build on a shared<br>query contract." zh="在同一份查询合同上<br>扩展业务能力。" /></h2>
          </div>
          <p class="section-lede">
            <T
              en="Core query semantics stay portable. Choose optional features explicitly, and use the backend guide to check which capabilities your database supports."
              zh="核心查询语义保持可移植。显式选择可选 feature，并通过后端指南确认目标数据库支持的能力。"
            />
          </p>
        </div>
        <div class="module-grid">
          {modules.map(({icon: Icon, ...item}) => (
            <article class="module-card">
              <span class="module-icon"><Icon size={19} /></span>
              <h3><T en={item.en} zh={item.zh} /></h3>
              <p><T en={item.bodyEn} zh={item.bodyZh} /></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section" id="delivery">
      <div class="section-inner">
        <div class="section-header">
          <p class="eyebrow"><T en="05 / Add it to your application" zh="05 / 接入现有应用" /></p>
          <h2><T en="Three steps.<br>Your Rust application." zh="三个步骤。<br>接入你的 Rust 应用。" /></h2>
        </div>
        <ol class="steps-grid">
          {steps.map((item, i) => (
            <li class="step-card">
              <div class="step-index">0{i + 1}</div>
              <h3><T en={item.en} zh={item.zh} /></h3>
              <p><T en={item.bodyEn} zh={item.bodyZh} /></p>
              <code class="step-cmd">{item.cmd}</code>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cta-section">
      <div class="section-inner">
        <div class="cta-card">
          <div class="cta-copy">
            <p class="eyebrow">SIFTQUERY / CRATES.IO / {siteVersion}</p>
            <h2><T en="Declare once.<br>Query with confidence." zh="一次声明。<br>按合同执行查询。" /></h2>
            <p>
              <T
                en={`Start with the runnable SQLite example, then select your production backend. Version ${siteVersion} is published; the API is pre-1.0.`}
                zh={`先运行 SQLite 示例，再选择生产后端。${siteVersion} 已发布，当前 API 为 pre-1.0。`}
              />
            </p>
          </div>
          <div class="cta-actions">
            <div class="install-bar">
              <code>{installCmd}</code>
              <button type="button" class="copy-inline" data-copy-text={installCmd}>
                <Copy size={13} aria-hidden="true" />
                <span><T en="Copy" zh="复制" /></span>
              </button>
            </div>
            <div class="cta-buttons">
              <BracketLink href={startHref}>
                <T en="Open the quick start" zh="打开快速开始" />
                <ArrowRight size={15} />
              </BracketLink>
              <BracketLink href="https://crates.io/crates/sift-query" variant="secondary" target="_blank" rel="noopener noreferrer">
                crates.io
              </BracketLink>
            </div>
            <span class="cta-meta">Rust 1.95+ · SQLx 0.9 · Apache-2.0</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
