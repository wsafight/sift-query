---
import BrandMark from './BrandMark.astro';
import T from './T.astro';
import {href, siteVersion} from '../catalog';
import {githubRepo, ui} from '../i18n';
const homeHref = href();
---
<footer class="site-footer">
  <div class="section-inner footer-layout">
    <div class="footer-brand">
      <div class="footer-signature"><BrandMark size={28} /><strong>SiftQuery</strong></div>
      <p><T en="A typed, parameter-driven, read-only query library for Rust and SQLx across PostgreSQL, MySQL/MariaDB and SQLite." zh="面向 Rust 与 SQLx 的类型化、参数驱动只读查询库，支持 PostgreSQL、MySQL/MariaDB 与 SQLite。" /></p>
      <p class="footer-legal">© 2026 SiftQuery contributors · Apache-2.0 · v{siteVersion}</p>
    </div>
    <div class="footer-col">
      <h3><T en="Overview" zh="概览" /></h3>
      <nav class="footer-nav" aria-label={ui.en.footerNav} data-i18n-aria="footerNav">
        <a href={`${homeHref}#compiler`}><T en={ui.en.compiler} zh={ui.zh.compiler} /></a>
        <a href={`${homeHref}#runtime`}><T en={ui.en.runtime} zh={ui.zh.runtime} /></a>
        <a href={`${homeHref}#modules`}><T en={ui.en.modules} zh={ui.zh.modules} /></a>
        <a href={`${homeHref}#delivery`}><T en={ui.en.delivery} zh={ui.zh.delivery} /></a>
      </nav>
    </div>
    <div class="footer-col">
      <h3><T en="Resources" zh="资源" /></h3>
      <nav class="footer-nav" aria-label="Resources">
        <a href={href('docs')}><T en={ui.en.docs} zh={ui.zh.docs} /></a>
        <a href={href('start/quick-start')}><T en={ui.en.quickStart} zh={ui.zh.quickStart} /></a>
        <a href={href('project/changelog')}><T en="Changelog" zh="变更记录" /></a>
        <a href="https://crates.io/crates/sift-query" target="_blank" rel="noopener noreferrer">crates.io</a>
        <a href="https://docs.rs/sift-query" target="_blank" rel="noopener noreferrer">docs.rs</a>
        <a href={githubRepo} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </div>
</footer>
